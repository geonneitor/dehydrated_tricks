---
import { SITE, waLink } from '../data/products';
---

<footer class="sugarmelon-footer" id="contacto">
  <!-- Fondo y decoraciones estilo "semillas" o confeti -->
  <div class="footer-bg" aria-hidden="true"></div>

  <div class="footer-container">
    <div class="footer-left">
      <h2 class="footer-massive-title">
        <span class="line-1">GUAW</span><br/>
        <span class="line-2">& MIAW</span>
      </h2>
      
      <p class="footer-desc">
        Premios 100% naturales, un solo ingrediente y cero culpa.<br/>Listos para hacer feliz a tu mascota.
      </p>

      <a href={waLink('¡Hola! Quiero hacer un pedido, ya no quiero darles premios con químicos')} class="footer-contact-link" target="_blank" rel="noopener noreferrer">
        CONTACTO ->
      </a>
    </div>

    <div class="footer-right">
      <div class="footer-column" style="width: 100%; max-width: 340px;">
        <h4 class="footer-eyebrow">NUESTRA TIENDITA</h4>
        <div class="map-container">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d956.3620816393251!2d-99.04904059211455!3d19.335977704601525!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1ses-419!2smx!4v1791260027992!5m2!1ses-419!2smx" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="strict-origin-when-cross-origin"
            title="Ubicación de la tienda">
          </iframe>
        </div>
      </div>

      <div class="footer-column">
        <h4 class="footer-eyebrow">HECHO CON</h4>
        <div class="footer-tags">
          <span>AMOR</span>
          <span>PROTEÍNA REAL</span>
          <span>CERO QUÍMICOS</span>
        </div>
      </div>

      <div class="footer-copyright">
        COPYRIGHT {SITE.year} {SITE.fullName}
      </div>
    </div>
  </div>
  
  <!-- WhatsApp Flotante -->
  <a
    href={waLink('¡Hola! Tengo una duda sobre los premios deshidratados')}
    class="fab-whatsapp"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escríbenos por WhatsApp"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
  </a>
</footer>

<style>
  .sugarmelon-footer {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, var(--cream) 0%, var(--sand) 40%, var(--sand-deep) 72%, var(--sand) 100%);
    overflow: hidden;
    padding: 8rem 0 4rem 0;
    transition: background 0.4s ease;
  }

  .footer-bg {
    position: absolute;
    inset: 0;
    /* Patrón de puntitos sutiles */
    background-image: radial-gradient(color-mix(in srgb, var(--brown-dark) 12%, transparent) 2px, transparent 2px),
                      radial-gradient(rgba(var(--pink-rgb), 0.08) 2px, transparent 2px);
    background-size: 80px 80px, 120px 120px;
    background-position: 0 0, 40px 40px;
    z-index: 1;
  }

  .footer-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    min-height: 50vh;
  }

  @media(min-width: 1024px) {
    .footer-container {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .footer-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 2rem;
  }

  .footer-massive-title {
    font-family: var(--font-display);
    font-weight: 900;
    /* Reducido para que no quede desfasado y no tape el header */
    font-size: clamp(3rem, 12vw, 8rem); 
    line-height: 0.95;
    color: var(--brown-dark);
    margin: 0 0 1.5rem 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .footer-desc {
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    color: var(--brown-dark);
    font-weight: 500;
    line-height: 1.5;
    max-width: 400px;
    margin-bottom: 3rem;
  }

  .footer-contact-link {
    font-family: var(--font-body);
    font-size: clamp(1.2rem, 3vw, 2.2rem);
    color: var(--brown-dark);
    text-decoration: none;
    display: inline-block;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--pink-soft);
    transition: border-color 0.3s;
    align-self: flex-start;
  }

  .footer-contact-link:hover {
    border-color: var(--pink);
  }

  .footer-right {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  @media(min-width: 1024px) {
    .footer-right {
      align-items: flex-end;
      text-align: right;
    }
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media(min-width: 1024px) {
    .footer-column {
      align-items: flex-end;
    }
  }

  .footer-eyebrow {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--brown-soft);
    margin: 0;
    text-transform: uppercase;
  }

  .footer-column p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--brown-dark);
    font-weight: 600;
    line-height: 1.5;
  }

  .map-container {
    width: 100%;
    height: 180px;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(0,0,0,0.1);
    box-shadow: 0 8px 24px rgba(var(--ink-rgb), 0.15);
    margin-top: 4px;
    transition: transform 0.3s ease;
  }

  .map-container:hover {
    transform: translateY(-4px);
  }

  .footer-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media(min-width: 1024px) {
    .footer-tags {
      justify-content: flex-end;
      max-width: 300px;
    }
  }

  .footer-tags span {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--brown-dark);
    text-transform: uppercase;
  }

  .footer-copyright {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--brown-soft);
    text-transform: uppercase;
    margin-top: 1rem;
  }

  /* El fab whatsapp se mantiene pero adaptado para no estorbar */
  .fab-whatsapp {
    z-index: 100;
  }
</style>

