---
import { SITE, waLink } from '../data/products';
import logoMain from '../assets/logos/logo-main.png';
---

<nav class="navbar" id="navbar">
  <div class="container navbar__inner">
    <a href="#inicio" class="navbar__logo">
      <img src={logoMain.src} alt={SITE.fullName} width="46" height="46" />
      {SITE.name}
    </a>
    <div class="navbar__links">
      <a href="#productos">Productos</a>
      <a href="#contacto">Contacto</a>
    </div>
    <div class="navbar__actions">
      <a href={waLink('¡Hola! Me interesan los premios deshidratados')} class="btn btn--primary" target="_blank" rel="noopener noreferrer">
        Pedir ahora
      </a>
    </div>
  </div>
</nav>

<script>
  // Fondo del navbar al hacer scroll (legibilidad sobre cualquier sección)
  const navbar = document.getElementById('navbar');
  const onScroll = () => navbar?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .navbar__actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @media (max-width: 860px) {
    .navbar__actions .btn {
      padding: 0.5rem 1rem;
      font-size: 0.85rem;
    }
  }
</style>
