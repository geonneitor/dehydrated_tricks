---
import mascotPlaying from '../assets/mascot/mascot-playing.png';
import mascotMegaphone from '../assets/mascot/mascot-megaphone.png';
import kibbleFlower from '../assets/kibble/kibble-flower.png';
import kibbleHeart from '../assets/kibble/kibble-heart.png';

const content = [
  {
    tag: 'Tip Nutricional',
    title: 'Nutrientes intactos.',
    text: 'Al deshidratar a baja temperatura, cada premio conserva su valor original.',
    review: '«Increíble. Mi perrita dejó de tirar tanto pelo desde que le doy el hígado. Se nota que es carne de verdad, nada que ver con los empaques del súper.»',
    author: '— Ana C.',
    accent: '#FF3D5E',
  },
  {
    tag: 'Entrenamiento',
    title: 'El aliado perfecto.',
    text: 'Para razas pequeñas, puedes partir fácilmente las mollejas u orejas en trozos.',
    review: '«Son mágicos para entrenar. Rompo los charales en pedacitos y mi gato hace literalmente lo que sea por ellos. Súper recomendados.»',
    author: '— Roberto M.',
    accent: '#8C2332',
  },
  {
    tag: 'Tip Práctico',
    title: 'Agua siempre lista.',
    text: 'Los premios aumentan su sed, dales agüita fresca. No necesitan refrigeración.',
    review: '«Súper prácticos. Los tengo en la alacena hace semanas y siguen igual de crujientes. A mis huskies les encantan las orejas de cerdo.»',
    author: '— Diana V.',
    accent: '#1B6E8C',
  },
];
---

<section class="sugarmelon-recommendations" id="tips">
  <!-- Torn paper divider top -->
  <div class="torn-paper-top" aria-hidden="true">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none">
      <path d="M0,60 L0,30 Q150,0 300,30 T600,30 T900,30 T1200,30 L1200,60 Z" fill="var(--cream)"></path>
    </svg>
  </div>

  <div class="container relative z-10">
    <header class="recommendations-head">
      <span class="kicker"><span class="kicker-star">✦</span> La Guía</span>
      <h2 class="section-title t-title">Secretos <span class="accent-script">Naturales</span></h2>
    </header>

    <div class="collage-grid" data-tips-grid>
      {content.map((item, index) => {
        // Asignamos clases de card basadas en el índice para mantener el diseño del collage
        const cardClass = `card-${index + 1}`;
        return (
          <>
            <article class={`collage-card rotator-card ${cardClass}`} style={`--tip: ${item.accent};`}>
              <div class="card-content tip-mode active">
                <span class="editorial-tag" style={`color: ${item.accent};`}>{item.tag}</span>
                <h3 class="editorial-title" style={`color: ${item.accent};`}>{item.title}</h3>
                <p class="editorial-text">{item.text}</p>
              </div>
              <div class="card-content review-mode">
                <div class="review-stars" style={`color: ${item.accent};`}>★★★★★</div>
                <p class="editorial-text review-text">{item.review}</p>
                <div class="review-author-wrapper">
                  <span class="review-author">{item.author}</span>
                  <span class="google-badge">
                    <svg viewBox="0 0 24 24" width="14" height="14" class="google-icon"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
                    Reseña en Google
                  </span>
                </div>
              </div>
            </article>

            {/* Insertamos los decorativos en los lugares específicos del collage */}
            {index === 0 && (
              <div class="collage-asset asset-1">
                <img src={mascotMegaphone.src} alt="Mascota con megáfono" class="float-anim" />
                <img src={kibbleHeart.src} alt="" class="kibble kibble-1" aria-hidden="true" />
              </div>
            )}
            {index === 2 && (
              <div class="collage-asset asset-2">
                <img src={mascotPlaying.src} alt="Mascota jugando" class="float-anim-alt" />
                <img src={kibbleFlower.src} alt="" class="kibble kibble-2" aria-hidden="true" />
                <img src={kibbleHeart.src} alt="" class="kibble kibble-3" aria-hidden="true" />
              </div>
            )}
          </>
        );
      })}
    </div>
  </div>
</section>

<style>
  .sugarmelon-recommendations {
    position: relative;
    padding-block: var(--space-6) var(--space-5);
    background: var(--surface-muted);
    overflow: hidden;
    transition: background-color 0.4s ease;
  }

  .torn-paper-top {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 4vw;
    min-height: 40px;
    z-index: 5;
    transform: rotate(180deg);
  }

  .torn-paper-top svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .recommendations-head {
    text-align: center;
    margin-bottom: var(--space-5);
  }

  .section-title {
    color: var(--brown-dark);
    margin: 0;
  }

  .collage-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(120px, auto);
    gap: var(--space-3);
    position: relative;
    max-width: 1100px;
    margin: 0 auto;
  }

  .collage-card {
    background: var(--white);
    border-radius: var(--radius-xl);
    box-shadow: 0 15px 35px -10px rgba(var(--ink-rgb), 0.08);
    position: relative;
    z-index: 2;
    transition: transform var(--dur-med) var(--ease-bounce);
    display: grid; /* Importante para encimar contenido */
    overflow: hidden;
  }

  .collage-card:hover {
    transform: scale(1.03) rotate(-1deg);
  }

  /* Contenedores que se rotan */
  .card-content {
    grid-area: 1 / 1;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    opacity: 0;
    pointer-events: none;
    transform: translateY(15px);
    transition: opacity 0.8s ease, transform 0.8s var(--ease-out);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .card-content.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* Estilos específicos de reseñas */
  .review-stars {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    letter-spacing: 0.1em;
  }

  .review-text {
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .review-author-wrapper {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 4px;
  }

  .review-author {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--brown);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .google-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--brown-soft);
    background: color-mix(in srgb, var(--brown) 8%, transparent);
    padding: 3px 8px;
    border-radius: 99px;
  }

  .google-icon {
    display: inline-block;
    vertical-align: middle;
  }

  .card-1 {
    grid-column: 1 / 6;
    grid-row: 1 / 3;
    background: linear-gradient(135deg, var(--white) 60%, color-mix(in srgb, var(--tip) 15%, var(--white)) 100%);
  }

  .asset-1 {
    grid-column: 6 / 10;
    grid-row: 1 / 4;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .asset-1 img:not(.kibble) {
    max-width: 140%;
    transform: rotate(4deg);
    filter: drop-shadow(0 20px 30px rgba(var(--ink-rgb), 0.15));
  }

  .card-2 {
    grid-column: 9 / 13;
    grid-row: 2 / 4;
    background: linear-gradient(135deg, var(--white) 60%, color-mix(in srgb, var(--tip) 15%, var(--white)) 100%);
  }

  .card-3 {
    grid-column: 2 / 7;
    grid-row: 3 / 5;
    background: linear-gradient(135deg, var(--white) 60%, color-mix(in srgb, var(--tip) 15%, var(--white)) 100%);
    z-index: 3;
  }

  .asset-2 {
    grid-column: 7 / 12;
    grid-row: 4 / 6;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .asset-2 img:not(.kibble) {
    max-width: 110%;
    transform: rotate(-6deg);
    filter: drop-shadow(0 20px 30px rgba(var(--ink-rgb), 0.15));
  }

  /* Kibbles animadas */
  .kibble {
    position: absolute;
    width: clamp(30px, 5vw, 60px);
    height: auto;
    z-index: 5;
    filter: drop-shadow(0 10px 15px rgba(var(--ink-rgb), 0.2));
  }

  .kibble-1 {
    top: 10%;
    right: -10%;
    animation: float-kibble 6s ease-in-out infinite alternate;
  }

  .kibble-2 {
    bottom: -10%;
    left: 0;
    animation: float-kibble 8s ease-in-out infinite alternate-reverse;
  }

  .kibble-3 {
    top: -20%;
    right: 20%;
    animation: float-kibble 7s ease-in-out infinite alternate;
  }

  @keyframes float-kibble {
    0% { transform: translateY(0) rotate(0deg); }
    100% { transform: translateY(-30px) rotate(20deg); }
  }

  .float-anim {
    animation: float-gentle 8s ease-in-out infinite;
  }
  
  .float-anim-alt {
    animation: float-gentle 9s ease-in-out infinite reverse;
  }

  @keyframes float-gentle {
    0%, 100% { transform: translateY(0) rotate(2deg); }
    50% { transform: translateY(-15px) rotate(-2deg); }
  }

  .tips-armed .collage-card {
    opacity: 0;
    transform: translateY(40px) scale(0.95);
    transition: opacity 0.6s var(--ease-bounce), transform 0.6s var(--ease-bounce);
  }
  
  .tips-armed .collage-card.in-view {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 900px) {
    .collage-grid {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-4);
    }
    .collage-card {
      width: 100%;
    }
    .asset-1, .asset-2 {
      width: 80%;
      margin: var(--space-2) 0;
    }
    .asset-1 img:not(.kibble), .asset-2 img:not(.kibble) {
      max-width: 100%;
    }
  }
</style>

<script>
  const grid = document.querySelector('[data-tips-grid]');

  if (grid && 'IntersectionObserver' in window) {
    grid.classList.add('tips-armed');
    const cards = grid.querySelectorAll('.collage-card');

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -50px 0px' }
    );

    cards.forEach((card) => io.observe(card));
  }

  // Lógica para rotar Tips y Testimonios
  const rotators = document.querySelectorAll('.rotator-card');
  rotators.forEach((card, index) => {
    // Desfasar el inicio de la animación de cada tarjeta para que no cambien todas al mismo tiempo
    setTimeout(() => {
      setInterval(() => {
        const modes = card.querySelectorAll('.card-content');
        modes.forEach(m => m.classList.toggle('active'));
      }, 7000); // Cambia cada 7 segundos
    }, index * 2000); // Desfase de 2 segundos entre tarjetas
  });
</script>
