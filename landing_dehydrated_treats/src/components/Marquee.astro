---
const items = ['100% NATURAL', 'CERO CULPA', 'UN SOLO INGREDIENTE', 'APROBADO POR VETERINARIOS', 'SABOR IRRESISTIBLE', 'HECHO EN MÉXICO'];
const track = [...items, ...items];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {track.map((item, i) => <span>{item} {i % 2 === 0 ? <em>🐾</em> : '·'}</span>)}
  </div>
</div>
