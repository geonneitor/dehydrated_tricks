---
import { products, waLink } from '../data/products';
import card1 from '../assets/products/charales.png';
import card2 from '../assets/products/higados.png';
import card3 from '../assets/products/orejas.png';
import card4 from '../assets/products/mollejas.png';
import card5 from '../assets/products/patitas.png';

// Import spec images
import spec1 from '../assets/specs/charales-spec.png';
import spec2 from '../assets/specs/higados-spec.png';
import spec3 from '../assets/specs/orejas-spec.png';
import spec4 from '../assets/specs/mollejas-spec.png';
import spec5 from '../assets/specs/patitas-spec.png';

const cardImages = [card1, card2, card3, card4, card5];
const specImages = [spec1, spec2, spec3, spec4, spec5];
---

<section class="sugarmelon-store" id="productos">
  <div class="container">
    <header class="store-header">
      <div class="kicker">
        <span class="kicker-star">✦</span> La tiendita
      </div>
      <h2 class="store-title t-title">
        Premios frescos, <span class="accent-script">ofertas jugosas.</span>
      </h2>
      <p class="store-desc">
        Nuestros premios de un solo ingrediente, en dos tamaños. Precios en pesos mexicanos;
        toca una tarjeta para ver la etiqueta nutrimental completa.
      </p>
    </header>

    <!-- Aviso de gesto: en móvil la fila es deslizable y cada tarjeta abre el panel -->
    <p class="swipe-hint" aria-hidden="true">
      Toca un premio · <strong>desliza</strong> para verlos todos <span class="swipe-hint__arrow">→</span>
    </p>

    <div class="products-row">
      {products.map((p, i) => (
        <article class="product-card">
          <img
            src={cardImages[i].src}
            alt=""
            class="product-card__img"
            width={cardImages[i].width}
            height={cardImages[i].height}
          />

          <!-- Sólo visual: el botón estirado de abajo ya announce "Ver etiqueta..." -->
          <span class="product-card__hint" aria-hidden="true">Toca para ver la etiqueta</span>

          <!-- Texto real en el HTML: indexable y visible sin JavaScript -->
          <div class="product-card__body">
            <h3 class="product-card__name">{p.name}</h3>
            <p class="product-card__claim">{p.proteinLabel} · {p.tagline}</p>
            <ul class="product-card__prices">
              {p.presentations.map((pres) => (
                <li class={pres.isPopular ? 'product-card__pres is-popular' : 'product-card__pres'}>
                  <span>{pres.name} <em>{pres.weight}</em></span>
                  <strong>${pres.price}</strong>
                </li>
              ))}
            </ul>
          </div>

          <!-- Botón estirado: toda la tarjeta abre el detalle sin anidar elementos interactivos -->
          <button
            class="product-card-btn"
            type="button"
            data-id={p.id}
            data-name={p.name}
            data-spec={specImages[i].src}
            data-spec-w={specImages[i].width}
            data-spec-h={specImages[i].height}
          >
            <span class="sr-only">Ver etiqueta nutrimental y precios de {p.name}</span>
          </button>
        </article>
      ))}
    </div>
  </div>

  <dialog id="nutrition-modal" class="nutrition-modal" aria-labelledby="nutrition-modal-title">
    <div class="modal-body">
      <div class="app-modal-wrapper">
        <!-- Barra superior: identifica el producto y deja cerrar el panel -->
        <header class="modal-topbar">
          <div class="modal-topbar__text">
            <p class="modal-topbar__kicker">Premio deshidratado</p>
            <!-- El nombre accesible del diálogo se reescribe con el producto abierto -->
            <h2 class="modal-topbar__title" id="nutrition-modal-title">
              <span data-modal-product>Premios Guaw &amp; Miaw</span>
              <small>Etiqueta y porción diaria</small>
            </h2>
          </div>
          <button class="modal-close-glass" id="btn-close-modal" type="button" aria-label="Cerrar información">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
          </button>
        </header>

        <!-- Sólo en móvil: en escritorio caben las dos columnas a la vez -->
        <div class="modal-tabs" role="group" aria-label="Vistas del panel">
          <button class="modal-tab is-active" id="tab-calc" type="button" data-view="calc" aria-controls="calc-mount-point" aria-pressed="true">Tu porción</button>
          <button class="modal-tab" id="tab-spec" type="button" data-view="spec" aria-controls="spec-content" aria-pressed="false">Etiqueta</button>
        </div>

        <div class="modal-panels" id="modal-panels" data-view="calc">
          <!-- Columna izquierda: ficha del producto + su etiqueta. La imagen crece o
               encoge con el espacio disponible, por eso el panel no necesita scroll. -->
          <div class="modal-panel modal-panel--spec" id="spec-content" tabindex="-1">
            <!-- Resumen y precios por producto (HTML real, se muestra el de la tarjeta abierta) -->
            {products.map((p) => (
              <div class="modal-summary" data-detail={p.id} hidden>
                <h3 class="modal-summary__name">{p.name}</h3>
                <p class="modal-summary__claim">{p.proteinLabel} · {p.tagline}</p>
                <p class="modal-summary__ingredients">{p.ingredients}</p>
                <div class="modal-summary__options">
                  {p.presentations.map((pres) => (
                    <a
                      href={waLink(`¡Hola! Quiero pedir ${p.name} — ${pres.name} (${pres.weight}) a $${pres.price}`)}
                      target="_blank"
                      rel="noopener noreferrer"
                      style={`--accent: ${p.accentDeep};`}
                    >
                      <span>{pres.name} <em>{pres.weight}</em></span>
                      <strong>${pres.price}</strong>
                    </a>
                  ))}
                </div>
              </div>
            ))}

            <div class="spec-frame">
              <a class="spec-zoom" id="spec-zoom" target="_blank" rel="noopener noreferrer">
                <img id="spec-img" class="spec-img-full" alt="" width="1545" height="2000" />
                <span class="spec-zoom__hint">Ampliar etiqueta</span>
              </a>
            </div>
          </div>

          <!-- Columna derecha: la calculadora real de la página, precargada con este premio.
               Aquí se monta #calculator-host mientras el modal está abierto. -->
          <div class="modal-panel modal-panel--calc" id="calc-mount-point" tabindex="-1"></div>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  const modal = document.getElementById('nutrition-modal') as HTMLDialogElement | null;
  const panels = document.getElementById('modal-panels');
  const calcMount = document.getElementById('calc-mount-point');
  const specImg = document.getElementById('spec-img') as HTMLImageElement | null;
  const specZoom = document.getElementById('spec-zoom') as HTMLAnchorElement | null;
  const btnClose = document.getElementById('btn-close-modal');
  const modalProduct = document.querySelector('[data-modal-product]') as HTMLElement | null;
  const calcHost = document.getElementById('calculator-host');
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.modal-tab'));

  /** Contenedor de origen de la calculadora (sección #calculadora), siempre presente en la página. */
  const calcHome = () => document.querySelector<HTMLElement>('#calculadora .container');

  /** Producto de la tarjeta que se está viendo. */
  let activeProductId = '';

  type View = 'calc' | 'spec';

  /** En móvil se ve una vista a la vez; en escritorio conviven las dos columnas. */
  function setView(view: View) {
    if (panels) panels.dataset.view = view;
    tabs.forEach((tab) => {
      const active = tab.dataset.view === view;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-pressed', String(active));
    });
  }

  /**
   * Sincroniza el premio de la tarjeta abierta en el select de la calculadora.
   * Reutiliza la lógica del componente disparando su propio evento 'change'.
   */
  function syncCalcProduct() {
    if (!calcHost) return;
    const select = calcHost.querySelector<HTMLSelectElement>('#calc-product');
    const option = activeProductId
      ? calcHost.querySelector<HTMLOptionElement>(`#calc-product option[value="${activeProductId}"]`)
      : null;
    if (select && option && !option.disabled && select.value !== activeProductId) {
      select.value = activeProductId;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }

  /** El foco cae dentro de la vista recién mostrada (no en <body>). */
  function focusView(view: View) {
    if (view === 'calc') {
      const first = calcHost?.querySelector<HTMLElement>('input, select, button, a[href]');
      if (first) {
        first.focus({ preventScroll: true });
        return;
      }
    }
    const panel = document.getElementById(view === 'calc' ? 'calc-mount-point' : 'spec-content');
    panel?.focus({ preventScroll: true });
  }

  /** El panel abre directo con la calculadora de ese premio: sin dock ni botones intermedios. */
  function openPanel() {
    if (modal && !modal.open) modal.showModal();
    if (calcHost && calcMount) {
      calcMount.appendChild(calcHost);
      calcMount.scrollTop = 0;
      syncCalcProduct();
    }
    setView('calc');
    void panels?.offsetWidth; // asienta el layout antes de mover el foco
    focusView('calc');
  }

  /** Al cerrar, la única instancia de la calculadora vuelve a su sección. */
  function sendCalculatorHome() {
    if (calcHost) calcHome()?.appendChild(calcHost);
    setView('calc');
  }

  /** Trampa de foco: el <dialog> nativo deja escapar el Tab al resto del documento. */
  modal?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || !modal) return;
    const focusables = Array.from(
      modal.querySelectorAll<HTMLElement>('a[href], button, input, select, [tabindex]:not([tabindex="-1"])')
    ).filter((el) => el.offsetParent !== null && !el.hasAttribute('disabled'));
    if (focusables.length === 0) return;

    const first = focusables[0];
    const last = focusables[focusables.length - 1];
    if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    } else if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    }
  });

  document.querySelectorAll<HTMLElement>('.product-card-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const { id = '', name = '', spec = '', specW, specH } = btn.dataset;
      activeProductId = id;

      if (modalProduct) modalProduct.textContent = name;
      modal?.querySelectorAll<HTMLElement>('[data-detail]').forEach((block) => {
        block.hidden = block.dataset.detail !== id;
      });
      if (specImg) {
        if (specW) specImg.width = Number(specW);
        if (specH) specImg.height = Number(specH);
        specImg.src = spec;
        specImg.alt = `Etiqueta nutrimental de ${name}`;
      }
      // La etiqueta se abre en su tamaño real (fuera del panel) para no obligar a scrollear.
      if (specZoom) specZoom.href = spec;

      openPanel();
      // Evita que la página siga desplazándose por detrás del modal (Lenis o scroll nativo).
      document.dispatchEvent(new CustomEvent('gm:scroll-lock'));
    });
  });

  btnClose?.addEventListener('click', () => modal?.close());

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const view: View = tab.dataset.view === 'spec' ? 'spec' : 'calc';
      setView(view);
      void panels?.offsetWidth;
      focusView(view);
    });
  });

  // Cerrar con Esc o clic en el fondo también restaura la calculadora y el scroll.
  modal?.addEventListener('close', () => {
    sendCalculatorHome();
    document.dispatchEvent(new CustomEvent('gm:scroll-unlock'));
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) modal.close();
  });
</script>

<style>
  .sugarmelon-store {
    padding-block: var(--space-6);
    background-color: var(--cream);
    background-image: radial-gradient(color-mix(in srgb, var(--brown-dark) 5%, transparent) 2px, transparent 0);
    background-size: 30px 30px;
    transition: background-color 0.4s ease;
  }

  .store-header {
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .store-title {
    color: var(--brown-dark);
    margin: 0 0 12px 0;
  }

  .store-desc {
    color: var(--brown-soft);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    font-weight: 600;
    max-width: 40rem;
    margin: 0 auto;
  }

  /* Grid de productos fluido y auto-adaptable */
  .products-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    padding-bottom: 1rem;
    width: 100%;
  }

  /* Avisos de gesto: ocultos fuera del móvil, donde la fila no es deslizable */
  .swipe-hint,
  .product-card__hint {
    display: none;
  }

  @keyframes swipe-nudge {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(6px); }
  }

  @media (max-width: 600px) {
    /* Mejora ergonómica: Carrusel deslizable horizontal en móviles */
    .products-row {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 1.5rem;
      margin-inline: -5%; /* Sangría negativa para que llegue al borde de la pantalla */
      padding-inline: 5%; /* Espaciado inicial */
      gap: 1rem;
      /* El borde derecho se desvanece: se ve que la fila sigue más allá */
      -webkit-mask-image: linear-gradient(to right, #000 86%, transparent 100%);
      mask-image: linear-gradient(to right, #000 86%, transparent 100%);
    }

    .products-row::-webkit-scrollbar {
      display: none; /* Ocultar barra de scroll para un look más limpio */
    }

    .product-card {
      flex: 0 0 70vw; /* Cada tarjeta ocupa el 70% del ancho de la pantalla */
      scroll-snap-align: center; /* Se ajusta al centro automáticamente */
    }

    /* La fila es deslizable y las tarjetas abren el detalle: se dice explícitamente */
    .swipe-hint {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      margin: -6px 0 16px;
      padding: 7px 14px;
      border-radius: 999px;
      background: var(--white);
      color: var(--brown-soft);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.09);
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .swipe-hint strong {
      color: var(--brown-dark);
    }

    .swipe-hint__arrow {
      color: var(--pink);
      font-size: 1em;
      animation: swipe-nudge 1.6s ease-in-out infinite;
    }

    .product-card__hint {
      display: block;
      position: absolute;
      top: 14px;
      left: 14px;
      right: 14px;
      z-index: 1; /* por debajo del botón estirado (z-index: 2), que sigue recibiendo el clic */
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(20, 10, 13, 0.72);
      backdrop-filter: blur(6px);
      color: #fff;
      text-align: center;
      font-size: 0.66rem;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      pointer-events: none;
    }
  }

  /* Tarjeta tipo ticket: artículo + botón estirado, para poder tener
     título y precios como texto real (un <button> sólo admite phrasing content). */
  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--white);
    padding: 9px 9px 22px;
    border-radius: 14px 14px 5px 5px;
    filter: drop-shadow(0 12px 22px rgba(var(--ink-rgb), 0.12));
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.3s ease;
  }

  .product-card::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 8px;
    background: conic-gradient(from 135deg at 50% 0%, var(--white) 90deg, transparent 0) 0 0 / 16px 8px repeat-x;
  }

  .product-card:hover {
    transform: translateY(-10px) scale(1.05);
    filter: drop-shadow(0 22px 34px rgba(50, 16, 28, 0.18));
  }

  .product-card__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }

  .product-card__body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 12px 4px 0;
  }

  .product-card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--brown-dark);
  }

  .product-card__claim {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--brown-soft);
  }

  .product-card__prices {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 6px;
    padding-top: 10px;
    border-top: 2px dashed color-mix(in srgb, var(--brown-dark) 18%, transparent);
  }

  .product-card__pres {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--brown-soft);
  }

  .product-card__pres em {
    font-style: normal;
    opacity: 0.75;
  }

  .product-card__pres strong {
    font-size: 0.9rem;
    font-weight: 900;
    color: var(--brown-dark);
    white-space: nowrap;
  }

  .product-card__pres.is-popular strong {
    color: var(--pink);
  }

  /* Botón estirado: cubre la tarjeta completa y es el único elemento interactivo */
  .product-card-btn {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }

  /* ── Resumen del modal: nombre, ingrediente y las dos presentaciones ── */
  .modal-summary {
    flex: none; /* no se comprime: la columna reserva su espacio de verdad */
    padding: 16px 20px 12px;
    background: var(--cream);
  }

  .modal-summary__name {
    margin: 0 0 4px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--brown-dark);
  }

  .modal-summary__claim {
    margin: 0 0 8px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--brown-soft);
  }

  .modal-summary__ingredients {
    margin: 0 0 12px;
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--brown-soft);
  }

  .modal-summary__options {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .modal-summary__options a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--white);
    color: var(--brown-dark);
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 60%, transparent);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .modal-summary__options a:hover {
    background: color-mix(in srgb, var(--accent) 22%, var(--white));
  }

  .modal-summary__options span em {
    font-style: normal;
    font-weight: 700;
    color: var(--brown-soft);
  }

  .modal-summary__options strong {
    font-size: 1rem;
    font-weight: 900;
    color: var(--brown-dark);
  }

  /* ═══════════ PANEL DE PRODUCTO ═══════════
     Barra superior + dos columnas (ficha/etiqueta · calculadora).
     Todo está dimensionado para caber sin desplazar nada: la etiqueta se
     ajusta al espacio restante y la barra deslizadora no aparece. */
  .nutrition-modal {
    border: none;
    border-radius: var(--radius-xl);
    padding: 0;
    width: min(980px, 94vw);
    max-width: 94vw;
    max-height: 98vh;
    background: transparent;
    overflow: visible;
    margin: auto;
  }

  .nutrition-modal[open] {
    animation: modalPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
  @keyframes modalPop {
    0% { opacity: 0; transform: scale(0.95) translateY(20px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  .nutrition-modal::backdrop {
    background: rgba(15, 8, 10, 0.75);
    backdrop-filter: blur(10px);
    animation: fadeBackdrop 0.4s ease forwards;
  }
  @keyframes fadeBackdrop {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  /* Altura definida (no sólo máxima): así la etiqueta puede resolverse con
     porcentajes y ocupar exactamente el espacio que sobra, sin desplazar nada. */
  .app-modal-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    height: min(92vh, 880px);
    min-height: 0;
    background: var(--cream);
  }

  /* ── Barra superior ── */
  .modal-topbar {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 12px 12px 20px;
    background: var(--white);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.07);
    z-index: 5;
  }

  .modal-topbar__kicker {
    margin: 0 0 2px;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--pink);
  }

  .modal-topbar__title {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 8px;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.3rem);
    font-weight: 900;
    line-height: 1.15;
    color: var(--brown-dark);
  }

  .modal-topbar__title small {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brown-soft);
  }

  .modal-close-glass {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    color: #fff;
    display: grid;
    place-items: center;
    transition: transform var(--dur-fast), background var(--dur-fast);
  }

  .modal-close-glass:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .modal-close-glass svg {
    width: 18px;
    height: 18px;
  }

  /* ── Pestañas: sólo en móvil ── */
  .modal-tabs {
    flex: none;
    display: none;
    gap: 6px;
    padding: 10px 14px;
    background: var(--white);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, 0.07);
  }

  .modal-tab {
    flex: 1;
