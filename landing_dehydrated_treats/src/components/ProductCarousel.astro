---
import { products } from '../data/products';
import card1 from '../assets/products/charales.png';
import card2 from '../assets/products/higados.png';
import card3 from '../assets/products/orejas.png';
import card4 from '../assets/products/mollejas.png';
import card5 from '../assets/products/patitas.png';

// Import spec images
import spec1 from '../assets/specs/charales-spec.png';
import spec2 from '../assets/specs/higados-spec.png';
import spec3 from '../assets/specs/orejas-spec.png';
import spec4 from '../assets/specs/mollejas-spec.png';
import spec5 from '../assets/specs/patitas-spec.png';

import PortionCalculator from './PortionCalculator.astro';

const cardImages = [card1, card2, card3, card4, card5];
const specImages = [spec1, spec2, spec3, spec4, spec5];
---

<section class="sugarmelon-store" id="productos">
  <div class="container">
    <header class="store-header">
      <div class="kicker">
        <span class="kicker-star">✦</span> La tiendita
      </div>
      <h2 class="store-title t-title">
        Premios frescos, <span class="accent-script">ofertas jugosas.</span>
      </h2>
      <p class="store-desc">
        Nuestros premios de un solo ingrediente. Toca una tarjeta para ver la información nutrimental.
      </p>
    </header>

    <div class="products-row">
      {products.map((p, i) => (
        <button class="product-card-btn" data-product={JSON.stringify(p)} data-spec={specImages[i].src}>
          <img
            src={cardImages[i].src}
            alt={`Tarjeta de ${p.name}`}
            class="product-card__img"
          />
        </button>
      ))}
    </div>
  </div>

  <dialog id="nutrition-modal" class="nutrition-modal">
    <div class="modal-body" id="modal-body">
      <!-- Content injected by JS -->
    </div>
  </dialog>

  <!-- Contenedor oculto para preservar el estado de la calculadora cuando el modal se cierra o cambia de producto -->
  <div id="hidden-calc-storage" style="display: none;">
    <div class="modal-calc-wrapper" id="modal-calc-wrapper">
       <PortionCalculator />
    </div>
  </div>
</section>

<script>
  const modal = document.getElementById('nutrition-modal') as HTMLDialogElement;
  const modalBody = document.getElementById('modal-body');
  const calcWrapper = document.getElementById('modal-calc-wrapper');
  
  const buttons = document.querySelectorAll('.product-card-btn');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const product = JSON.parse((btn as HTMLElement).dataset.product || '{}');
      const specSrc = (btn as HTMLElement).dataset.spec || '';
      
      // SALVAR LA CALCULADORA ANTES DE REESCRIBIR EL DOM
      if (calcWrapper && document.getElementById('hidden-calc-storage')) {
        document.getElementById('hidden-calc-storage')?.appendChild(calcWrapper);
      }
      
      if (modalBody) {
        modalBody.innerHTML = `
          <div class="app-modal-wrapper">
            <button class="modal-close-glass" id="btn-close-modal" aria-label="Cerrar modal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"></path></svg>
            </button>
            
            <div class="app-modal-scroll" id="spec-content">
              <div style="position: relative; display: block; width: 100%;">
                <img src="${specSrc}" alt="Especificaciones de ${product.name}" class="spec-img-full" />
                <!-- Botón invisible que cubre toda la imagen para que sea infalible -->
                <div id="image-calc-trigger" class="invisible-calc-trigger" title="Calcula la porción"></div>
              </div>
            </div>
            
            <div id="calc-mount-point"></div>
            
            <div class="app-modal-dock">
              <button class="btn-dock btn-dock--calc" id="btn-show-calc" style="display: none;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                <span>Volver</span>
              </button>
              <a href="https://wa.me/525528462102?text=${encodeURIComponent(product.waMessage)}" class="btn-dock btn-dock--order" style="background: ${product.accentDeep}; flex: 1;" target="_blank" rel="noopener noreferrer">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.82 9.82 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                WhatsApp
              </a>
            </div>
          </div>
        `;

        // Asignar el nuevo botón de cierre
        const btnClose = modalBody.querySelector('#btn-close-modal');
        if (btnClose) {
          btnClose.addEventListener('click', () => modal?.close());
        }
        
        // Lógica de intercambio (swap) entre imagen y calculadora
        const btnCalc = document.getElementById('btn-show-calc');
        const specContent = document.getElementById('spec-content');
        const calcMount = document.getElementById('calc-mount-point');



        const imageTrigger = document.getElementById('image-calc-trigger');
        
        // Al dar clic en el texto falso de la imagen, abrir calculadora
        imageTrigger?.addEventListener('click', () => {
          if (!calcWrapper || !calcMount || !specContent) return;
          specContent.style.display = 'none';
          calcMount.appendChild(calcWrapper);
          btnCalc.style.display = 'flex'; // Mostrar botón de "Volver"
        });

        // Al dar clic en volver, regresar a la imagen
        btnCalc?.addEventListener('click', () => {
          if (!calcWrapper || !calcMount || !specContent) return;
          document.getElementById('hidden-calc-storage')?.appendChild(calcWrapper);
          specContent.style.display = 'block';
          btnCalc.style.display = 'none'; // Ocultar botón de "Volver"
        });
      }
      modal?.showModal();
    });
  });



  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      modal.close();
    }
  });
</script>

<style>
  .sugarmelon-store {
    padding-block: var(--space-6);
    background-color: var(--cream);
    background-image: radial-gradient(color-mix(in srgb, var(--brown-dark) 5%, transparent) 2px, transparent 0);
    background-size: 30px 30px;
    transition: background-color 0.4s ease;
  }

  .store-header {
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .store-title {
    color: var(--brown-dark);
    margin: 0 0 12px 0;
  }

  .store-desc {
    color: var(--brown-soft);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    font-weight: 600;
    max-width: 40rem;
    margin: 0 auto;
  }

  /* Grid de productos fluido y auto-adaptable */
  .products-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.5rem;
    padding-bottom: 1rem;
    width: 100%;
  }

  @media (max-width: 600px) {
    /* Mejora ergonómica: Carrusel deslizable horizontal en móviles */
    .products-row {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 1.5rem;
      margin-inline: -5%; /* Sangría negativa para que llegue al borde de la pantalla */
      padding-inline: 5%; /* Espaciado inicial */
      gap: 1rem;
    }

    .products-row::-webkit-scrollbar {
      display: none; /* Ocultar barra de scroll para un look más limpio */
    }

    .product-card-btn {
      flex: 0 0 70vw; /* Cada tarjeta ocupa el 70% del ancho de la pantalla */
      scroll-snap-align: center; /* Se ajusta al centro automáticamente */
    }
  }

  /* Tarjeta tipo ticket */
  .product-card-btn {
    position: relative;
    width: 100%;
    background: var(--white);
    border: none;
    padding: 9px 9px 22px;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), filter 0.3s ease, background-color 0.4s ease;
    border-radius: 14px 14px 5px 5px;
    filter: drop-shadow(0 12px 22px rgba(var(--ink-rgb), 0.12));
  }

  .product-card-btn::before {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 13px;
    border-top: 2px dashed color-mix(in srgb, var(--brown-dark) 18%, transparent);
  }

  .product-card-btn::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    height: 8px;
    background: conic-gradient(from 135deg at 50% 0%, var(--white) 90deg, transparent 0) 0 0 / 16px 8px repeat-x;
  }

  .product-card-btn:hover {
    transform: translateY(-10px) scale(1.05);
    filter: drop-shadow(0 22px 34px rgba(50, 16, 28, 0.18));
  }

  .product-card__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
  }



  /* PREMIUM MODAL STYLES */
  .nutrition-modal {
    border: none;
    border-radius: var(--radius-xl);
    padding: 0;
    max-width: 440px; 
    width: 92%;
    background: transparent;
    overflow: visible; 
    margin: auto; 
  }

  .nutrition-modal[open] {
    animation: modalPop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
  @keyframes modalPop {
    0% { opacity: 0; transform: scale(0.95) translateY(20px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  .nutrition-modal::backdrop {
    background: rgba(15, 8, 10, 0.75);
    backdrop-filter: blur(10px);
    animation: fadeBackdrop 0.4s ease forwards;
  }
  @keyframes fadeBackdrop {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  /* ── App Modal UI ── */
  .app-modal-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: 85vh;
    background: var(--cream);
  }

  .modal-close-glass {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(20, 10, 13, 0.3);
    backdrop-filter: blur(8px);
    color: #fff;
    display: grid;
    place-items: center;
    z-index: 20;
    transition: transform var(--dur-fast), background var(--dur-fast);
  }

  .modal-close-glass:hover {
    background: rgba(20, 10, 13, 0.5);
    transform: scale(1.1);
  }

  .modal-close-glass svg {
    width: 18px;
    height: 18px;
  }

  .app-modal-scroll {
    overflow-y: auto;
    overflow-x: hidden;
    width: 100%;
    padding-bottom: 90px; /* Espacio para el dock */
  }
  
  .spec-img-full {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .app-modal-dock {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    padding: 1.2rem 1.5rem;
    display: flex;
    gap: 0.75rem;
    background: linear-gradient(to top, var(--cream) 60%, transparent);
    backdrop-filter: blur(4px);
    z-index: 10;
  }

  .btn-dock {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    flex: 1;
    padding: 0.9rem 0.5rem;
    border-radius: 14px;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    box-shadow: 0 8px 20px rgba(var(--ink-rgb), 0.15);
    transition: transform var(--dur-fast) var(--ease-bounce), box-shadow var(--dur-fast);
  }

  .btn-dock:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 25px rgba(var(--ink-rgb), 0.2);
  }

  .btn-dock svg {
    width: 20px;
    height: 20px;
  }

  .btn-dock--calc {
    background: var(--white);
    color: var(--brown-dark);
    flex: 0.8;
  }

  .btn-dock--order {
    color: #fff;
    flex: 1.2;
    position: relative;
    overflow: hidden;
  }

  /* Shimmer effect for primary button */
  .btn-dock--order::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(to right, transparent, rgba(255,255,255,0.3), transparent);
    transform: skewX(-20deg);
    animation: shimmer 3s infinite;
  }

  @keyframes shimmer {
    0% { left: -100%; }
    20% { left: 200%; }
    100% { left: 200%; }
  }

  .modal-calc-wrapper {
    background: transparent;
    padding: 0 0 90px 0; /* Padding inferior para el dock */
    height: 100%;
    overflow-y: auto;
  }
  
  /* Override calculator internal background to fit the dark theme naturally */
  .modal-calc-wrapper :global(.portion-calculator) {
    box-shadow: none !important;
    border-radius: 0 !important;
    margin: 0 !important;
  }

  .invisible-calc-trigger {
    position: absolute;
    inset: 0; /* Cubre absolutamente toda la imagen para no fallar */
    width: 100%;
    height: 100%;
    background: transparent;
    cursor: pointer;
    z-index: 10;
  }
  
  .invisible-calc-trigger:hover {
    background: rgba(255, 255, 255, 0.05); /* Feedback visual muy sutil */
  }

</style>
