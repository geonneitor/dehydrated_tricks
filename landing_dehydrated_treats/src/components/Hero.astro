---
import kibbleHeart from '../assets/kibble/kibble-heart.png';
import kibbleFlower from '../assets/kibble/kibble-flower.png';
import heroTreat1 from '../assets/products/charales.png';
import heroTreat2 from '../assets/products/higados.png';
---

<section class="hero-sugarmelon" id="inicio">
  <div class="hero-sugarmelon__bg" aria-hidden="true">
    <div class="blob blob--1"></div>
    <div class="blob blob--2"></div>
    <div class="blob blob--3"></div>
  </div>

  <div class="container hero-sugarmelon__grid">
    <div class="hero-sugarmelon__copy">
      <div class="kicker">
        <span class="kicker-star">✦</span> Cero culpa · 100% natural · un solo ingrediente
      </div>
      
      <h1 class="hero-title t-display">
        <span class="font-bold">Nutrición pura,</span><br/>
        <span class="accent-script">cero rellenos.</span>
      </h1>
      
      <p class="hero-desc">
        Premios de un solo ingrediente deshidratado. Olvídate de los químicos; dale el sabor y la salud que su instinto necesita.
      </p>

      <div class="hero-actions">
        <a href="#calculadora" class="btn btn--glass">Calcula la porción</a>
        <a href="#productos" class="btn btn--primary">Quiero verlos felices</a>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <strong>1</strong>
          <span>Ingrediente</span>
        </div>
        <div class="hero-stat">
          <strong>0</strong>
          <span>Conservadores</span>
        </div>
        <div class="hero-stat">
          <strong>68%</strong>
          <span>Proteína máx.</span>
        </div>
      </div>
    </div>

    <!-- 3D Tilt: mascota flotante con profundidad -->
    <div class="hero-3d-stage" data-tilt-stage>
      <div class="tilt-scene" data-tilt-scene>
        <div class="tilt-shadow" aria-hidden="true"></div>
        <!-- Composición de productos premium -->
        <div class="hero-treats-composition">
          <img
            src={heroTreat2.src}
            alt="Hígados deshidratados premium"
            class="hero-treat hero-treat--back"
            loading="eager"
            fetchpriority="high"
          />
          <img
            src={heroTreat1.src}
            alt="Charales deshidratados premium"
            class="hero-treat hero-treat--front"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
      <div class="tilt-gloss" aria-hidden="true"></div>
      <!-- Decorative floating kibbles at different depths -->
      <img src={kibbleFlower.src} alt="" class="float-kibble float-kibble--a" aria-hidden="true" width={kibbleFlower.width} height={kibbleFlower.height} loading="lazy" />
      <img src={kibbleHeart.src} alt="" class="float-kibble float-kibble--b" aria-hidden="true" width={kibbleHeart.width} height={kibbleHeart.height} loading="lazy" />
    </div>
  </div>
</section>



<style>
  /* Scoped CSS para el Hero estilo Sugarmelon */
  .hero-sugarmelon {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: clamp(5.5rem, 12vh, 8rem);
    padding-bottom: var(--space-5);
    background: radial-gradient(ellipse at 8% 92%, color-mix(in srgb, var(--sand) 50%, transparent), transparent 45%),
                radial-gradient(ellipse at 72% 48%, rgba(var(--pink-rgb), 0.1), transparent 56%);
  }

  /* Landscape corto: la sección crece en vez de recortar contenido */
  @media (max-height: 700px) {
    .hero-sugarmelon { min-height: auto; }
  }

  .hero-sugarmelon__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero-sugarmelon__grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: var(--space-4);
    z-index: 10;
    position: relative;
  }

  /* Title Typography: fuente y escala fluida vienen de .t-display global */
  .hero-title {
    margin: 0;
    color: var(--brown-dark);
  }

  .hero-title .accent-script {
    font-size: 1.1em;
  }

  .hero-title .font-light {
    font-weight: 400;
  }

  .hero-title .font-bold {
    font-weight: 900;
  }

  /* Description */
  .hero-desc {
    margin-top: 24px;
    max-width: 28rem;
    font-size: clamp(0.95rem, 1.35vw, 1.05rem);
    line-height: 1.65;
    color: var(--brown-soft);
    font-weight: 600;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  /* Botones: base y variantes viven en global.css (.btn) */

  /* Stats */
  .hero-stats {
    display: flex;
    gap: var(--space-4);
    margin-top: 48px;
  }

  .hero-stat strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--brown-dark);
    line-height: 1.1;
  }

  .hero-stat span {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--pink-ink);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* ═══ 3D Tilt: mascota flotante ═══ */
  .hero-3d-stage {
    --gx: 0;
    --gy: 0;

    position: relative;
    width: 100%;
    max-width: clamp(280px, 70vw, 470px);
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    display: grid;
    place-items: center;
    perspective: 1100px;
  }



  .tilt-scene {
    position: relative;
    width: 92%;
    animation: floating 6s ease-in-out infinite;
  }

  @keyframes floating {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  .hero-treats-composition {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-treat {
    position: absolute;
    width: 75%;
    height: auto;
    filter: drop-shadow(0 26px 30px rgba(var(--ink-rgb), 0.25));
    transition: transform var(--dur-med) var(--ease-out);
  }

  /* Treat de atrás (Hígados) */
  .hero-treat--back {
    width: 65%;
    top: 5%;
    right: 0%;
    transform: rotate(15deg);
    filter: drop-shadow(0 15px 20px rgba(var(--ink-rgb), 0.15)) brightness(0.9);
    z-index: 1;
    animation: float-back 8s ease-in-out infinite;
  }

  /* Treat de adelante (Charales) */
  .hero-treat--front {
    bottom: 5%;
    left: -5%;
    transform: rotate(-10deg);
    z-index: 2;
    animation: float-front 6s ease-in-out infinite;
  }

  @keyframes float-front {
    0%, 100% { transform: translateY(0) rotate(-10deg); }
    50% { transform: translateY(-12px) rotate(-8deg); }
  }

  @keyframes float-back {
    0%, 100% { transform: translateY(0) rotate(15deg); }
    50% { transform: translateY(12px) rotate(18deg); }
  }

  /* Sombra debajo de la mascota */
  .tilt-shadow {
    position: absolute;
    left: 50%;
    bottom: -5%;
    width: 64%;
    height: 7%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(var(--ink-rgb), 0.28), transparent);
    filter: blur(7px);
    transform: translateX(-50%);
    animation: shadow-pulse 6s ease-in-out infinite;
  }
  
  @keyframes shadow-pulse {
    0%, 100% { transform: translateX(-50%) scale(1); opacity: 1; }
    50% { transform: translateX(-50%) scale(0.85); opacity: 0.6; }
  }

  /* Decoraciones / Blobs */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    animation: blob-drift 18s ease-in-out infinite alternate;
  }

  .blob--1 { width: 46vw; height: 46vw; background: var(--pink-soft); top: -12%; right: -8%; }
  .blob--2 { width: 34vw; height: 34vw; background: var(--sand); bottom: -10%; left: -6%; animation-delay: -6s; }
  .blob--3 { width: 18vw; height: 18vw; background: var(--sand-deep); top: 40%; left: 42%; animation-delay: -12s; }

  @keyframes blob-drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(6vw, -4vh) scale(1.15); }
  }

  /* Croquetas flotantes: translateZ propio = parallax al rotar la escena.
     El vaivén usa las propiedades individuales translate/rotate para no
     pisar el transform de profundidad. */
  .float-kibble {
    position: absolute;
    z-index: 2;
    width: 46px;
    opacity: 0.9;
    transform: translateZ(95px);
    animation: kibble-bob 7s ease-in-out infinite;
    filter: drop-shadow(0 8px 12px rgba(var(--ink-rgb), 0.18));
    pointer-events: none;
  }

  .float-kibble--a { top: -6%; left: -7%; animation-delay: -2s; }
  .float-kibble--b { bottom: -2%; right: -4%; width: 36px; transform: translateZ(150px); animation-delay: -4.5s; }

  @keyframes kibble-bob {
    0%, 100% { translate: 0 0; rotate: -10deg; }
    50% { translate: 0 -22px; rotate: 14deg; }
  }



  @media (max-width: 1024px) {
    .hero-sugarmelon__grid {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-3);
    }
    .hero-desc { margin-inline: auto; }
    .hero-actions, .hero-stats { justify-content: center; }
    .hero-3d-stage { margin-top: var(--space-2); max-width: clamp(260px, 60vw, 400px); }
  }

  @media (max-width: 480px) {
    /* Mejora ergonómica: Botones CTA grandes y fáciles de tocar en móviles */
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    
    .hero-actions .btn {
      width: 100%;
    }
  }
</style>
